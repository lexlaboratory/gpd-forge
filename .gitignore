# --- .NET / core ---
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/
artifacts/
publish/
*.dll
*.pdb

# --- Node / UI ---
node_modules/
dist/
dist-ssr/
dist-release/
.vite/
*.local

# --- Tauri ---
ui/src-tauri/target/
ui/src-tauri/gen/
# desktop-only: drop the generated mobile icon sets (keep desktop png/ico/icns)
ui/src-tauri/icons/android/
ui/src-tauri/icons/ios/

# --- Playwright ---
test-results/
playwright-report/
playwright/.cache/
tests/e2e/artifacts/

# --- OS / editor ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp

# --- Script runtime logs ---
scripts/logs/

# --- QA capture output (regenerated by scripts/qa-shot.mjs) ---
tests/manual/shots/

# --- Vendored third-party binaries ---
# PresentMon is fetched from Intel's signed release by scripts/fetch-presentmon.ps1 and its
# signature verified there. It is deliberately NOT committed: a ~1 MB binary does not belong in
# a source repo, and a downloaded-and-verified copy is easier to audit than a checked-in one.
vendor/

# --- Secrets ---
.env
.env.*
*.pem
*.key
